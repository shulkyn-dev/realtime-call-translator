# Скопируй этот файл в .env и впиши свой ключ DeepL.
# Ключ бесплатно: https://www.deepl.com/pro-api  (план DeepL API Free, 500k символов/мес)

DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# --- Необязательно (значения по умолчанию подходят для NVIDIA GPU) ---
# MODEL_SIZE=large-v3      # medium / small — если GPU слабая или мало VRAM
# DEVICE=cuda              # cpu — если нет NVIDIA GPU
# COMPUTE_TYPE=float16     # int8 — для CPU
# TARGET_LANG=RU
# SOURCE_LANG=EN
# SILENCE_RMS=0.006        # подними (0.01–0.02) если ловит фоновый шум
# SHOW_ORIGINAL=1          # 0 — прятать английский оригинал
